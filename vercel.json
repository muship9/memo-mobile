{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "migrate-to-chakra-ui": true
    }
  },
  "github": {
    "autoJobCancellation": true,
    "silent": false
  },
  "env": {
    "NODE_ENV": "production"
  }
}